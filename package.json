{
    "name": "bunsane",
    "version": "0.8.0",
    "description": "Experimental TypeScript API framework for Bun: entity-component storage on PostgreSQL, a fluent query builder, and GraphQL via Yoga.",
    "author": {
        "name": "yaaruu"
    },
    "keywords": [
        "bun",
        "framework",
        "entity-component-system",
        "ecs",
        "graphql",
        "typescript"
    ],
    "type": "module",
    "main": "index.ts",
    "module": "index.ts",
    "types": "index.ts",
    "exports": {
        ".": {
            "types": "./index.ts",
            "import": "./index.ts",
            "default": "./index.ts"
        },
        "./database": "./database/index.ts",
        "./database/projection": "./database/projection/index.ts",
        "./database/readmodel": "./database/readmodel/index.ts",
        "./core": "./core/index.ts",
        "./core/components": "./core/components/index.ts",
        "./core/middleware": "./core/middleware/index.ts",
        "./core/cache": "./core/cache/index.ts",
        "./core/scheduler": "./core/scheduler/index.ts",
        "./core/scheduler/locks": "./core/scheduler/locks/index.ts",
        "./core/metadata": "./core/metadata/index.ts",
        "./core/readmodel": "./core/readmodel/index.ts",
        "./core/remote": "./core/remote/index.ts",
        "./query": "./query/index.ts",
        "./query/planner": "./query/planner/index.ts",
        "./gql": "./gql/index.ts",
        "./gql/schema": "./gql/schema/index.ts",
        "./gql/builders": "./gql/builders/index.ts",
        "./gql/orchestration": "./gql/orchestration/index.ts",
        "./gql/utils": "./gql/utils/index.ts",
        "./gql/visitors": "./gql/visitors/index.ts",
        "./service": "./service/index.ts",
        "./scheduler": "./scheduler/index.ts",
        "./upload": "./upload/index.ts",
        "./swagger": "./swagger/index.ts",
        "./rest": "./rest/index.ts",
        "./plugins": "./plugins/index.ts",
        "./endpoints": "./endpoints/index.ts",
        "./*": "./*.ts",
        "./*/*": "./*/*.ts",
        "./*/*/*": "./*/*/*.ts",
        "./*/*/*/*": "./*/*/*/*.ts",
        "./*/*/*/*/*": "./*/*/*/*/*.ts"
    },
    "engines": {
        "bun": ">=1.1.0"
    },
    "files": [
        "index.ts",
        "config",
        "core",
        "database",
        "endpoints",
        "gql",
        "plugins",
        "query",
        "rest",
        "scheduler",
        "service",
        "storage",
        "studio/dist",
        "swagger",
        "types",
        "upload",
        "utils",
        "docs/README.md",
        "docs/CONFIGURATION.md",
        "docs/QUERY_LIST_GUIDE.md",
        "docs/QSP_OPERATIONS.md",
        "docs/READ_PATH_PERFORMANCE.md",
        "docs/POOLING.md",
        "docs/STANDALONE_SCRIPTS.md",
        "docs/LOCKING.md",
        "docs/UPGRADING.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "bun run build:studio && tsc",
        "build:studio": "cd studio && bun install && bun run build",
        "dev": "tsc --watch",
        "test": "bun test tests/unit tests/integration tests/graphql tests/public-api",
        "test:all": "bun test tests/unit tests/integration tests/graphql tests/e2e tests/perf tests/public-api",
        "test:unit": "bun test tests/unit/",
        "test:integration": "bun test tests/integration/",
        "test:graphql": "bun test tests/graphql/",
        "test:pglite": "bun tests/pglite-setup.ts tests/unit tests/integration tests/graphql tests/public-api",
        "test:pglite:unit": "bun tests/pglite-setup.ts tests/unit/",
        "test:pg": "bun tests/pg-setup.ts tests/unit tests/integration tests/graphql tests/public-api",
        "test:pg:unit": "bun tests/pg-setup.ts tests/unit/",
        "test:pg:integration": "bun tests/pg-setup.ts tests/integration/",
        "test:pg:graphql": "bun tests/pg-setup.ts tests/graphql/",
        "test:e2e": "SKIP_TEST_DB_SETUP=true bun test tests/e2e/",
        "test:stress": "bun test tests/stress --timeout 600000",
        "test:stress:smoke": "STRESS_RECORD_COUNT=10000 bun test tests/stress --timeout 300000",
        "test:stress:standard": "STRESS_RECORD_COUNT=100000 bun test tests/stress --timeout 600000",
        "test:stress:full": "STRESS_RECORD_COUNT=1000000 bun test tests/stress --timeout 1800000",
        "bench:generate:xs": "bun tests/benchmark/scripts/generate-db.ts xs",
        "bench:generate:sm": "bun tests/benchmark/scripts/generate-db.ts sm",
        "bench:generate:md": "bun tests/benchmark/scripts/generate-db.ts md",
        "bench:generate:lg": "bun tests/benchmark/scripts/generate-db.ts lg",
        "bench:generate:xl": "bun tests/benchmark/scripts/generate-db.ts xl",
        "bench:generate:all": "bun tests/benchmark/scripts/generate-db.ts --all",
        "bench:run:xs": "bun tests/benchmark/scripts/run-benchmarks.ts xs",
        "bench:run:sm": "bun tests/benchmark/scripts/run-benchmarks.ts sm",
        "bench:run:md": "bun tests/benchmark/scripts/run-benchmarks.ts md",
        "bench:run:lg": "bun tests/benchmark/scripts/run-benchmarks.ts lg",
        "bench:run:xl": "bun tests/benchmark/scripts/run-benchmarks.ts xl",
        "bench:baseline:xs": "BENCH_BASELINE=write bun tests/benchmark/scripts/run-benchmarks.ts xs",
        "bench:baseline:md": "BENCH_BASELINE=write bun tests/benchmark/scripts/run-benchmarks.ts md",
        "bench:gate": "bun tests/benchmark/scripts/run-benchmarks.ts md",
        "bench:pg:compare": "bun tests/benchmark/scripts/compare-pg.ts",
        "bench:pg:compare:lg": "bun tests/benchmark/scripts/compare-pg.ts --scale lg",
        "bench:pg:gate": "bun tests/benchmark/scripts/compare-pg.ts --gate",
        "bench:pg:gate:lg": "bun tests/benchmark/scripts/compare-pg.ts --gate --scale lg",
        "bench:pg:concurrency": "bun tests/benchmark/scripts/compare-pg.ts --scale lg --concurrency 16 --duration 30",
        "test:pool-saturation": "bun tests/load/pool-saturation.ts",
        "knip": "knip --dependencies"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.3.15",
        "@electric-sql/pglite-socket": "^0.0.20",
        "@types/bun": "latest",
        "@types/node": "^25.0.3",
        "knip": "^5.78.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@gqloom/core": "^0.12.0",
        "@gqloom/zod": "^0.12.2",
        "dataloader": "2.2.2",
        "graphql": "16.11.0",
        "graphql-yoga": "5.15.1",
        "ioredis": "5.8.2",
        "pino": "9.9.0",
        "reflect-metadata": "0.2.2",
        "zod": "4.1.5"
    },
    "optionalDependencies": {
        "pino-pretty": "13.1.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yaaruu/bunsane.git"
    },
    "license": "MIT"
}
